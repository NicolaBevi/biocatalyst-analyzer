# =============================================================================
# BioCatalyst Analyzer — configurazione ambiente
# Copia questo file in ".env" e compila i valori. Non committare mai ".env".
# =============================================================================

# --- Provider LLM di default -------------------------------------------------
# Uno tra: anthropic | openai | deepseek | groq | gemini | ollama
DEFAULT_PROVIDER=deepseek
# Modello di default usato se un agente non specifica un override (opzionale)
DEFAULT_MODEL=

# --- API key per provider (compila solo quelle dei provider che usi) --------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...
# Ollama non richiede una API key: gira in locale.
OLLAMA_BASE_URL=http://localhost:11434

# --- Override provider/modello per singolo agente ----------------------------
# Se non impostati, l'agente usa DEFAULT_PROVIDER / DEFAULT_MODEL.
# Esempio: modello economico per l'analisi quantitativa, modello più capace
# per la scrittura del report finale.
AGENT_ANALYST_PROVIDER=deepseek
AGENT_ANALYST_MODEL=deepseek-chat

AGENT_NEWS_PROVIDER=deepseek
AGENT_NEWS_MODEL=deepseek-chat

AGENT_WRITER_PROVIDER=anthropic
# Verifica il nome del modello corrente sul sito del provider prima di usarlo.
AGENT_WRITER_MODEL=claude-sonnet-5

# --- SEC EDGAR ----------------------------------------------------------------
# Obbligatorio: la SEC richiede uno User-Agent identificativo (fair access policy).
# Formato consigliato: "NomeApp email@dominio.it"
SEC_EDGAR_USER_AGENT=BioCatalystAnalyzer tuo-indirizzo@email.it

# --- News (Finnhub) ------------------------------------------------------------
# Registrazione gratuita su https://finnhub.io/register
FINNHUB_API_KEY=

# --- Cache (TTL in secondi) ----------------------------------------------------
CACHE_DIR=.cache/biocatalyst
CACHE_TTL_PRICE_SECONDS=900
CACHE_TTL_FILING_SECONDS=86400
CACHE_TTL_TRIAL_SECONDS=86400

# --- Resilienza rete ------------------------------------------------------------
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
HTTP_REQUEST_TIMEOUT_SECONDS=30

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Report -------------------------------------------------------------------
# Default report language: "en" or "it".
REPORT_LANGUAGE=en

# Streaming delle risposte LLM. Tenerlo attivo: senza, le risposte lunghe
# vengono tagliate dal proxy di Streamlit Community Cloud (~60s).
LLM_USE_STREAMING=true
